# ==============================================================================
# PortafolioTitulo - .gitignore
# ==============================================================================

# Entornos virtuales y dependencias
.venv/
venv/
env/
node_modules/
.next/

# Bytecode y cachés de Python
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Artefactos de pruebas, cobertura y linters
.coverage
.pytest_cache/
.ruff_cache/
coverage.xml
pytest-*.xml

# Secretos, credenciales y variables de entorno
.env
.env.local
*.env
**/certs/*.pem
**/certs/*.crt
**/certs/*.key

# Bases de datos SQLite locales y colas Store-and-Forward
*.db
*.sqlite3
*.db-shm
*.db-wal

# Volcados temporales de pruebas y respuestas JSON locales
**/response.json
**/response_test.json
**/salida.json

# Archivos temporales de Office y del sistema operativo
~$*.docx
~$*.xlsx
.DS_Store
Thumbs.db
Desktop.ini

# Agentes de IA y configuración local
.antigravity
.AGENTS.md
AGENTS.md
agents.md
**/AGENTS.md
**/agents.md
