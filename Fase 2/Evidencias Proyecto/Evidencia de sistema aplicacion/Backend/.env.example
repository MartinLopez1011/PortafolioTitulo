# Copia este archivo como ".env" y completa los valores. NUNCA subas ".env" al repositorio.

# Misma cadena "Session pooler" o RDS que usas en Base de Datos/.env (opcional si MODO_DEMO=1)
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Modo demostración en memoria (1 para activar sin base de datos; requiere DEMO_CLAVE >= 8 caracteres)
MODO_DEMO=0
DEMO_CLAVE=CAMBIAR_CLAVE_DEMO

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Duración de la sesión en minutos (480 = 8 horas, un turno)
JWT_MINUTOS=480

# Clave compartida para /api/ingesta/registro y /api/telemetria (mínimo 24 caracteres)
CLAVE_INGESTA=CAMBIAR_POR_UNA_CLAVE_DE_INGESTA_LARGA

# Direcciones desde donde la web podrá llamar a la API (separadas por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

# Simulador e integración AWS
AWS_REGION=us-east-2
SIM_PUBLICAR=iot
IOT_ENDPOINT=
