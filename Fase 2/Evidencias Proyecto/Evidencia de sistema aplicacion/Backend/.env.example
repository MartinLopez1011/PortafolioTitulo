# Copia este archivo como ".env" y completa los valores. NUNCA subas ".env" al repositorio.

# Misma cadena "Session pooler" que usaste en Base de Datos/.env
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Duración de la sesión en minutos (480 = 8 horas, un turno)
JWT_MINUTOS=480

# Direcciones desde donde la web podrá llamar a la API (separadas por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500
